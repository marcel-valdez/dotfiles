#!/usr/bin/env bash
# jetski-notify: Displays a dynamically sized tmux popup notification via
# ~/bin/tmux-notify and restores focus to the originating pane on dismissal.
#
# Usage:
#   jetski-notify [title] <message...>
#
# Usage Example:
#   TARGET_PANE="%3" jetski-notify "Build Finished" "All targets passed."

TARGET_PANE="${TARGET_PANE:-${TMUX_PANE:-}}"
TITLE="${1:-}"
if (( $# > 1 )); then
  shift
  MESSAGE="$*"
else
  MESSAGE="${TITLE}"
  TITLE="JETSKI NOTIFICATION"
fi

notify_args=()
[[ -n "${TARGET_PANE}" ]] && notify_args+=(--select-pane "${TARGET_PANE}")
exec "${HOME}/bin/tmux-notify" "${notify_args[@]}" -- "${TITLE}" "${MESSAGE}"
