<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.marcelvaldez.clipboard-daemon</string>
  <key>ProgramArguments</key>
  <!-- Port: per-machine override in ~/.config/clipboard-daemon/port (e.g. 3336
       on a second Mac), else 3335. Exporting CLIPBOARD_PORT keeps the daemon
       from sourcing ~/.googlerc under launchd. -->
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>port="$(head -n 1 "${HOME}/.config/clipboard-daemon/port" 2>/dev/null)"; [[ "${port}" =~ ^[0-9]+$ ]] || port=3335; export CLIPBOARD_PORT="${port}"; exec /bin/bash "${HOME}/bin/clipboard-daemon.sh" "${port}"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/local/go/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/marcelvaldez/bin:/Users/marcelvaldez/.local/bin:/Users/marcelvaldez/.googlerc.d/bin:/opt/homebrew/bin:/opt/homebrew/sbin</string>
    <key>HOME</key>
    <string>/Users/marcelvaldez</string>
    <key>USER</key>
    <string>marcelvaldez</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/tmp/clipboard-daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/clipboard-daemon.err.log</string>
</dict>
</plist>
