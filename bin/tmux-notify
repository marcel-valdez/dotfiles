#!/usr/bin/env bash

TITLE="$1"
shift
MESSAGE="$*"

if [[ -z "${MESSAGE}" ]]; then
  MESSAGE="${TITLE}"
  TITLE="NOTIFICATION"
fi

line_count=$(echo "${MESSAGE}" | wc -l)
line_count=$((line_count+2))

b64_msg=$(printf "%s" "${MESSAGE}" | base64 -w0)
tmux display-popup -T "${TITLE}" -h "${line_count}" -E "tput civis; echo \"${b64_msg}\" | base64 -d; echo; read -s"
