#!/usr/bin/env ruby

require 'fileutils'

if ARGV.size < 2
  puts 'Title and message must be specified. Usage:'
  puts '  notify <title> <message>'
  exit 1
end

now = Time.now
time = "#{'%02d' % now.hour}:#{'%02d' % now.min}"
title = "#{time} #{ARGV[0]}"
message = ARGV[1]

log_dir = File.join(Dir.home, '.logs')
FileUtils.mkdir_p(log_dir)
File.open(File.join(log_dir, 'notify.log'), 'a') do |f|
  f.puts("#{title} #{message}")
end

if File.exist?('/usr/bin/gntp-send')
  system('gntp-send', '-s', 'localhost', title, message)
else
  system('notify-send', title, message)
end
