#!/usr/bin/env ruby

require 'fileutils'

if ARGV.size < 2
  puts 'Title and message must be specified. Usage:'
  puts '  notify <title> <message>'
  exit 1
end

now = Time.now
time = "#{'%02d' % now.hour}:#{'%02d' % now.min}"
title = "#{time} #{ARGV[0]}"
message = ARGV[1]

log_dir = File.join(Dir.home, '.logs')
FileUtils.mkdir_p(log_dir)
File.open(File.join(log_dir, 'notify.log'), 'a') do |f|
  f.puts("#{title} #{message}")
end

if RUBY_PLATFORM.include?('darwin')
  # Prefer terminal-notifier, but fall back to osascript when it is missing or
  # fails (e.g. blocked by Google Santa until the binary is approved).
  delivered = system('which terminal-notifier >/dev/null 2>&1') &&
              system('terminal-notifier', '-title', title, '-message', message)
  unless delivered
    system('osascript', '-e', 'on run argv', '-e', 'display notification (item 2 of argv) with title (item 1 of argv)', '-e', 'end run', '--', title, message)
  end
elsif File.exist?('/usr/bin/gntp-send')
  system('gntp-send', '-s', 'localhost', title, message)
else
  system('notify-send', title, message)
end
