#!/usr/bin/env bash

declare -a chrome_args
while [ $# -gt 0 ]; do
  case "$1" in
    -i|--index)
      profile_index="$2"
      shift
      ;;
    -l|--log-file)
      log_file="$2"
      shift
      ;;
    --remote-debugging)
      chrome_args+=("--remote-debugging-port=9222")
      ;;
    -h|--help)
      usage
      exit 0
      ;;
  esac
  shift
done

[ -z "${profile_index}" ] && profile_index=$(echo "${DISPLAY:-0}" | grep -o '[0-9]' | head -n 1)
[ -z "${profile_index}" ] && profile_index=0
[ -z "${log_file}" ] && log_file=/dev/null
chrome_args+=("--user-data-dir=${HOME}/.alt-google-chrome-profile${profile_index}")

if [[ "$(uname -s)" == "Darwin" ]] && [[ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]]; then
  CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
else
  CHROME_BIN="$(command -v google-chrome || echo /usr/bin/google-chrome)"
fi

"${CHROME_BIN}" "${chrome_args[@]}" &> "${log_file}" &
echo "Launching google chrome with alternative profile"
echo "This may take a few seconds..."
