# Exclude all files
*

# Except
!.bashrc
!.bash_logout
!.bash_functions
!.bash_aliases
!.bash_profile
!.profile
# Machine-local shell settings: same scheme as .config/kitty/local.conf.
.bashrc.local
.bash_aliases.local
.bash_functions.local
.bash_profile.local
.profile.local
!.inputrc
!.minttyrc
!.nanorc
!.tmux.conf
# Machine-local tmux settings: same scheme as .config/kitty/local.conf.
.tmux.conf.local
!.viminfo
!.vimrc
!.gitignore
!GOOGLE_OFFICE_MERGE.md
!.emacs
# Machine-local Emacs settings: same scheme as .config/kitty/local.conf.
.emacs.local
!.xbindkeysrc.scm
!.XCompose
!.Xmodmap
!.xinitrc
!.xsession
!.xprofile
!.xsessionrc
!.quotes
!.quotes.conkyrc
!.wezterm.lua
!.fzf.bash
!lib/
!res/
!res/*

# include the bin folder
!bin/
!bin/*
# include the scripts folder
!scripts/
!scripts/*
!scripts/tests/
!scripts/tests/*.sh
# with the exception of these binaries
bin/dex

# include custom emacs lisp configs
!.emacs.d/
!.emacs.d/lisp/
!.emacs.d/lisp/*
!.emacs.d/lisp/external
!.emacs.d/lisp/external/*
.emacs.d/lisp/external/helm/
!.emacs.d/lisp/themes
!.emacs.d/lisp/themes/*


# In order to unignore a specific file under a directory:
# 1. unignore the directory
!.vnc/
# 2. unignore the specific file
!.vnc/xstartup
!.vnc/config

!.nano/
!.nano/*
.nano/search_history

!.fluxbox/
!.fluxbox/keys
!.fluxbox/startup

!.config/
!.config/systemd/
!.config/systemd/user/
!.config/systemd/user/airgradient-monitor.service
!.config/kitty/
!.config/kitty/*
# Machine-local kitty overrides: only the commented template is tracked (added
# with `git add -f`); local edits stay out of commits via --skip-worktree.
.config/kitty/local.conf
!.config/termit/
!.config/termit/*
!.config/rofi/
!.config/rofi/*

!.local/
!.local/bin/
!.local/bin/pixel-buds-plugin.sh

!.pomodororc
# Ignore nano backup files
*~
bin/mail-notify-data
*.swp
*.pyc

# ignore emacs backup files
*#
**/*#*
**/*#*#

# ignore recipes folder (it has its own git repo)

recipes/*
recipes/**/*

# Common backup/generated files
.*~
**/.*~
*~
**/*~
*.swp
**/*.swp
*.pyc
**/*.pyc
*.lock
**/*.lock
*.bak
**/*.bak
*.tmp
**/*.tmp
*.log
**/*.log
.*#
*#