# Exclude all files
*

# Except
!.bashrc
!.bash_logout
!.bash_functions
!.bash_aliases
!.bash_profile
!.inputrc
!.minttyrc
!.nanorc
!.tmux.conf
!.viminfo
!.vimrc
!.gitignore
!.emacs
!.xbindkeysrc.scm
!.quotes.conkyrc
!.wezterm.lua
!.fzf.bash
!lib/

# include the bin folder
!bin/
!bin/*
# include the scripts folder
!scripts/
!scripts/*
# with the exception of these binaries
bin/dex

# include custom emacs lisp configs
!.emacs.d/
!.emacs.d/lisp/
!.emacs.d/lisp/*
.emacs.d/lisp/at-office.el
!.emacs.d/lisp/external
!.emacs.d/lisp/external/*
.emacs.d/lisp/external/helm/
!.emacs.d/lisp/themes
!.emacs.d/lisp/themes/*


# In order to unignore a specific file under a directory:
# 1. unignore the directory
!.vnc/
# 2. unignore the specific file
!.vnc/xstartup
!.vnc/config

!.nano/
!.nano/*
.nano/search_history

!.fluxbox/
!.fluxbox/keys
!.fluxbox/startup

!.pomodororc
# Ignore nano backup files
*~
bin/mail-notify-data
*.swp
*.pyc

# ignore emacs backup files
*#
**/*#*
**/*#*#

# ignore recipes folder (it has its own git repo)

recipes/*
recipes/**/*

# Common backup/generated files
.*~
**/.*~
*~
**/*~
*.swp
**/*.swp
*.pyc
**/*.pyc
*.lock
**/*.lock
*.bak
**/*.bak
*.tmp
**/*.tmp
*.log
**/*.log
.*#
*#