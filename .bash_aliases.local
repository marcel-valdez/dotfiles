# ~/.bash_aliases.local  -*- mode: sh -*-
#
# Machine-local aliases, NOT shared between machines. ~/.bash_aliases (loaded
# from ~/.bashrc) sources this file at its end, so aliases here override the
# shared ones.
#
# The repository only tracks this commented template (added with `git add -f`);
# put real per-machine aliases below it and never commit them.
#
# Once per clone, hide local edits from git:
#   git -C ~ update-index --skip-worktree .bash_aliases.local
# (undo with --no-skip-worktree, e.g. to update this template).
